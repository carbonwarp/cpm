---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import Banner from '../../components/Banner.astro';
import Button from '../../components/Button.astro';
import InstallDialog from '../../components/InstallDialog.astro';
import { installCommand } from '../../config';
import { getPackages } from '../../lib/packages';

export async function getStaticPaths() {
  const packages = await getPackages();
  return packages.map((pkg) => ({ params: { id: pkg.name }, props: { pkg } }));
}

const { pkg } = Astro.props;
---

<Base title={pkg.name} description={pkg.description}>
  <a href="/" class="text-sm text-muted hover:text-ink">← All packages</a>

  <div class="mt-4 flex flex-wrap items-center gap-6">
    <Avatar name={pkg.name} class="size-24 text-5xl" />
    <div class="min-w-0 flex-1">
      <h1 class="text-3xl font-bold">{pkg.name}</h1>
      <p class="mt-1 text-muted">{pkg.description}</p>
    </div>
    <Button data-open="install" class="px-8">Install</Button>
  </div>

  <Banner class="mt-8">
    <h2 class="font-semibold">Details</h2>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-muted">Package</dt>
      <dd>{pkg.name}</dd>
      <dt class="text-muted">Install</dt>
      <dd><code class="font-mono">{installCommand(pkg.name)}</code></dd>
    </dl>
  </Banner>

  <InstallDialog pkg={pkg.name} />
</Base>
