---
// Renders <a> when `href` is given, otherwise <button>. Extra attributes pass through.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  class?: string;
  [attr: string]: unknown;
}
const { href, variant = 'primary', size = 'md', class: cls, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';
const variants = {
  primary: 'bg-brand text-white hover:opacity-90',
  secondary: 'border border-line hover:border-brand',
};
const sizes = { md: 'px-6 py-2.5 text-sm', sm: 'px-3 py-1 text-xs' };
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-full font-semibold',
    variants[variant],
    sizes[size],
    cls,
  ]}
  {...rest}
>
  <slot />
</Tag>
